{
  "name": "holiday-sticker",
  "version": "1.0.0",
  "description": "Windows desktop holiday reminder sticker",
  "main": "./out/main/index.js",
  "scripts": {
    "start": "electron-vite dev",
    "build": "electron-vite build",
